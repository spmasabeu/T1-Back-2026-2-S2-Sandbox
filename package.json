{
  "name": "t1-back-2026-2-sandbox",
  "version": "1.0.0",
  "description": "Backend base para T1 2026-2 en TypeScript + Express",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && npm run check:rankings && npm run check:api && npm run check:rate-limit",
    "check:api": "node --import tsx scripts/api-selfcheck.ts",
    "check:rate-limit": "node --import tsx scripts/rate-limit-selfcheck.ts",
    "check:rankings": "node --import tsx scripts/ranking-selfcheck.ts",
    "perf": "node --import tsx scripts/load-test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.2"
  }
}
